# Frontend
VITE_API_URL=http://localhost:3001

# Backend / database
DATABASE_URL=
DB_POOL_MAX=12
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=15000
DB_MAX_LIFETIME_SECONDS=300

# Migration throughput
# Aggressive single-migration profile. Tune downward only if Drive/API or DB limits are reached.
MIGRATION_FILE_WORKERS=60

# Google-side Drive copy optimization.
MIGRATION_SERVER_SIDE_COPY=true
# Files larger than this use temporary source sharing after a target-side 404.
MIGRATION_SERVER_SIDE_COPY_SHARE_THRESHOLD_BYTES=524288

# Maximum simultaneous migrations. One migration gets the full 60-worker budget.
MIGRATION_MAX_CONCURRENT=1
# Permit a short-lived writer permission when the source explicitly requires writer access to copy.
MIGRATION_SERVER_SIDE_COPY_TEMPORARY_WRITER=true
# Reuse multiplexed HTTP/2 sessions for concurrent Drive API calls.
GOOGLE_DRIVE_HTTP2=true
